# Copy this file to .env and fill in real values. NEVER commit .env.
BOT_TOKEN=put-the-token-from-BotFather-here
# Channel ids need the -100 prefix
CHANNEL_ID=-100xxxxxxxxxx

# Optional
INCLUDE_UPLOADER=true
MAX_FILES_PER_SESSION=30
SEND_DELAY_SECONDS=3

# Webhook mode (Render). RENDER_EXTERNAL_URL is set by Render itself.
# WEBHOOK_SECRET: random string, only A-Z a-z 0-9 _ -
WEBHOOK_SECRET=
